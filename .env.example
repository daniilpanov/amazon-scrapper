RABBITMQ_HOST="msgbroker"
HOST="<your ip>"
HTTPS_READY=<true/false (default=false)>
# S3
S3_ACCESS_KEY="<key>"
S3_SECRET_KEY="<key>"
BASE_BUCKET="<name>"
# DATA IMPORTER
DATA_IMPORTER_API_KEY="<str>"
# ENV
ENVIRONMENT="develop"
# Google Drive
SERVICE_ACCOUNT_FILE="<auth file>"
# MongoDB
MONGO_DB_USER="<user>"
MONGO_DB_PASS="*****"
MONGO_DB_HOST="<mongo cluster url>"
MONGO_DB_HOST_SCHEMA="<mongodb+srv / mongodb>"
MONGO_DB_PROXY="<proxy (may be with auth)>"
# PORTS (809* - main, 883* - loaders)
S3_PORT=<number>
GOOGLE_PORT=<number>
SERVER_PORT=<number>
WEB_PORT=<number>
