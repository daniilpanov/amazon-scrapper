{
  "name": "Clutch.co Scraper",
  "description": "Scrap all data from clutch.co",
  "version": "1.0",
  "manifest_version": 3,
  "icons": {},
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "permissions": [
    "webNavigation",
    "tabs",
    "activeTab",
    "scripting",
    "alarms",
    "declarativeContent",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}