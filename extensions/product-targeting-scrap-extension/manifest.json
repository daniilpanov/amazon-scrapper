{
  "name": "Amazon Product Targeting Scraper",
  "description": "Scraper addon works with AmaScrap",
  "version": "1.0",
  "manifest_version": 3,
  "icons": {},
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "permissions": [
    "webNavigation",
    "tabs",
    "activeTab",
    "scripting",
    "alarms",
    "declarativeContent",
    "storage",
    "management"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "./html/popup.html"
  }
}