{
  "name": "Amazon Products Scraper",
  "description": "Scraper addon works with AmaScrap",
  "version": "2.0",
  "manifest_version": 3,
  "icons": {},
  "action": {},
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "permissions": [
    "webNavigation",
    "tabs",
    "activeTab",
    "scripting",
    "alarms",
    "declarativeContent",
    "storage",
    "management"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}